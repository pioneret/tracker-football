{
    "name": "@pioneret/tracker-football",
    "version": "0.1.0",
    "description": "A React library for real-time football match UI, featuring live ball position tracking, event display, and components for an interactive match experience.",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "style": "./dist/index.css",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "rollup -c --bundleConfigAsCjs --watch",
        "build": "npm run clean && npm run build:types && rollup -c --bundleConfigAsCjs",
        "clean": "rimraf dist .rollup.cache .types-cache",
        "typecheck": "tsc --noEmit",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "format": "prettier --check --ignore-path .gitignore .",
        "format:fix": "prettier --write --ignore-path .gitignore .",
        "prepublishOnly": "npm run typecheck && npm run build",
        "build:types": "tsc -p tsconfig.build.json"
    },
    "author": "Pioneret Team",
    "license": "MIT",
    "type": "commonjs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pioneret/tracker-football.git"
    },
    "bugs": {
        "url": "https://github.com/pioneret/tracker-football/issues"
    },
    "homepage": "https://github.com/pioneret/tracker-football#readme",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "react",
        "react19",
        "football",
        "soccer",
        "live-tracker",
        "match-tracker",
        "ball-tracking",
        "sports",
        "gsap",
        "ui-components"
    ],
    "dependencies": {
        "classnames": "^2.5.1"
    },
    "overrides": {
        "serialize-javascript": "^7.1.1"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.1.1",
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.2",
        "@storybook/addon-docs": "^9.1.10",
        "@storybook/react-vite": "^9.1.10",
        "@types/css-modules": "^1.0.5",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "gsap": "^3.13.0",
        "postcss-modules": "^6.0.1",
        "prettier": "^3.6.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "rimraf": "^6.0.1",
        "rollup": "^4.52.0",
        "rollup-plugin-dts": "^6.2.3",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-postcss": "^4.0.2",
        "storybook": "^9.1.10",
        "tslib": "^2.8.1",
        "typescript": "^5.9.2",
        "vite": "^7.1.5"
    },
    "peerDependencies": {
        "gsap": "^3.12.5",
        "react": "^18.2.0 || ^19.0.0"
    }
}
